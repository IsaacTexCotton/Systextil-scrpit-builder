{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/IsaacTexCotton/Systextil-scrpit-builder/schemas/screen-evidence.schema.json",
  "title": "Systextil Screen Evidence",
  "description": "Evidência técnica sanitizada de uma tela do Systextil. Não deve conter valores operacionais de campos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "capturedAt", "purpose", "source", "elements", "observations", "privacy", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$" },
    "capturedAt": { "type": "string", "minLength": 10, "maxLength": 40 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "environment", "viewName"],
      "properties": {
        "system": { "const": "Systextil NXJ" },
        "environment": { "type": "string", "enum": ["development", "homologation", "production", "unknown"] },
        "viewName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "pagePath": { "type": "string", "maxLength": 500, "description": "Caminho sem query string, token ou identificador de sessão." },
        "formNames": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } }
      }
    },
    "elements": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elementId", "tagName", "type", "visible", "disabled"],
        "properties": {
          "elementId": { "type": "string", "maxLength": 200 },
          "name": { "type": "string", "maxLength": 200 },
          "tagName": { "type": "string", "minLength": 1, "maxLength": 30 },
          "type": { "type": "string", "maxLength": 50 },
          "label": { "type": "string", "maxLength": 200 },
          "visible": { "type": "boolean" },
          "disabled": { "type": "boolean" },
          "readOnly": { "type": "boolean" },
          "required": { "type": "boolean" },
          "multiple": { "type": "boolean" }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "status", "details"],
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "type": "string", "enum": ["confirmed", "inferred", "unknown"] },
          "details": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidenceRef": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sanitized", "operatorReviewed", "excludedCategories"],
      "properties": {
        "sanitized": { "type": "boolean", "const": true },
        "operatorReviewed": { "type": "boolean" },
        "excludedCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["credentials", "personal-data", "customer-data", "financial-data", "transaction-values", "session-data", "request-payloads"]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 1000 }
    }
  }
}
